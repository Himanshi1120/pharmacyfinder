<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://example.com/pharmacy"
    xmlns:tns="http://example.com/pharmacy"
    elementFormDefault="qualified">

    <xs:element name="InventoryRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nm" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="InventoryResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nm" type="xs:string"/>
                <xs:element name="qty" type="xs:int"/>
                <xs:element name="avl" type="xs:boolean"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
